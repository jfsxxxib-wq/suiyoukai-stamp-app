{
  "textCases": [
    {
      "id": "plain-japanese",
      "input": "囲碁",
      "required": true,
      "expected": { "ok": true, "value": "囲碁", "length": 2 }
    },
    {
      "id": "trim-halfwidth-space",
      "input": "  囲碁  ",
      "required": true,
      "expected": { "ok": true, "value": "囲碁", "length": 2 }
    },
    {
      "id": "trim-fullwidth-space",
      "input": "　囲碁　",
      "required": true,
      "expected": { "ok": true, "value": "囲碁", "length": 2 }
    },
    {
      "id": "internal-space",
      "input": "囲碁 サロン",
      "required": true,
      "expected": { "ok": true, "value": "囲碁 サロン", "length": 6 }
    },
    {
      "id": "emoji",
      "input": "😊",
      "required": true,
      "expected": { "ok": true, "value": "😊", "length": 1 }
    },
    {
      "id": "flag",
      "input": "🇯🇵",
      "required": true,
      "expected": { "ok": true, "value": "🇯🇵", "length": 1 }
    },
    {
      "id": "family-zwj",
      "input": "👨‍👩‍👧‍👦",
      "required": true,
      "expected": { "ok": true, "value": "👨‍👩‍👧‍👦", "length": 1 }
    },
    {
      "id": "keycap",
      "input": "1️⃣",
      "required": true,
      "expected": { "ok": true, "value": "1️⃣", "length": 1 }
    },
    {
      "id": "decomposed-dakuten",
      "input": "が",
      "required": true,
      "expected": { "ok": true, "value": "が", "length": 1 }
    },
    {
      "id": "variation-selector",
      "input": "✈️",
      "required": true,
      "expected": { "ok": true, "value": "✈️", "length": 1 }
    },
    {
      "id": "empty-optional",
      "input": "",
      "required": false,
      "expected": { "ok": true, "value": "", "length": 0 }
    },
    {
      "id": "empty-required",
      "input": "",
      "required": true,
      "expected": { "ok": false, "code": "required", "length": 0 }
    },
    {
      "id": "exactly-30",
      "input": "ああああああああああああああああああああああああああああああ",
      "required": true,
      "expected": { "ok": true, "length": 30 }
    },
    {
      "id": "over-30-not-truncated",
      "input": "あああああああああああああああああああああああああああああああ",
      "required": true,
      "expected": { "ok": false, "code": "too_long", "length": 31, "preserveInput": true }
    },
    {
      "id": "line-feed",
      "input": "囲碁\nサロン",
      "required": true,
      "expected": { "ok": false, "code": "contains_newline" }
    },
    {
      "id": "carriage-return",
      "input": "囲碁\rサロン",
      "required": true,
      "expected": { "ok": false, "code": "contains_newline" }
    },
    {
      "id": "next-line",
      "input": "囲碁サロン",
      "required": true,
      "expected": { "ok": false, "code": "contains_newline" }
    },
    {
      "id": "line-separator",
      "input": "囲碁 サロン",
      "required": true,
      "expected": { "ok": false, "code": "contains_newline" }
    },
    {
      "id": "paragraph-separator",
      "input": "囲碁 サロン",
      "required": true,
      "expected": { "ok": false, "code": "contains_newline" }
    },
    {
      "id": "tab",
      "input": "囲碁\tサロン",
      "required": true,
      "expected": { "ok": false, "code": "invalid_format" }
    },
    {
      "id": "c0-control",
      "input": "囲碁\u0007サロン",
      "required": true,
      "expected": { "ok": false, "code": "invalid_format" }
    },
    {
      "id": "c1-control",
      "input": "囲碁サロン",
      "required": true,
      "expected": { "ok": false, "code": "invalid_format" }
    },
    {
      "id": "unpaired-high-surrogate",
      "input": "\ud800",
      "required": true,
      "expected": { "ok": false, "code": "invalid_format" }
    },
    {
      "id": "unpaired-low-surrogate",
      "input": "\udc00",
      "required": true,
      "expected": { "ok": false, "code": "invalid_format" }
    },
    {
      "id": "unpaired-surrogate-before-newline",
      "input": "\ud800\n",
      "required": true,
      "expected": { "ok": false, "code": "invalid_format" }
    },
    {
      "id": "non-string",
      "input": 123,
      "required": true,
      "expected": { "ok": false, "code": "invalid_format" }
    }
  ],
  "twoLineCases": [
