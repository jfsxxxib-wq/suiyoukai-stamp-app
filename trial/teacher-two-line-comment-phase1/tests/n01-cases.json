  "decisionCases": [
    {
      "id": "N01-01-no-open-comment",
      "processedResults": [],
      "openComments": [],
      "expected": {
        "decision": "create_draft"
      }
    },
    {
      "id": "N01-02-one-draft",
      "processedResults": [],
      "openComments": ["draft"],
      "expected": {
        "decision": "persist_existing_comment",
        "responseResult": "existing_comment",
        "status": "draft",
        "requestResult": "existing_comment"
      }
    },
    {
      "id": "N01-03-one-pending-review",
      "processedResults": [],
      "openComments": ["pending"],
      "expected": {
        "decision": "persist_existing_comment",
        "responseResult": "existing_comment",
        "status": "pending_review",
        "requestResult": "existing_comment"
      }
    },
    {
      "id": "N01-04-draft-and-pending",
      "processedResults": [],
      "openComments": ["draft", "pending"],
      "expected": {
        "decision": "integrity_stop",
        "reasonCode": "multiple_open_comments",
        "detectedCommentIds": [
          "cmt_11111111-1111-4111-8111-111111111111",
          "cmt_22222222-2222-4222-8222-222222222222"
        ]
      }
    },
    {
      "id": "N01-05-two-drafts-sorted",
      "processedResults": [],
      "openComments": ["draftLater", "draft"],
      "expected": {
        "decision": "integrity_stop",
        "reasonCode": "multiple_open_comments",
        "detectedCommentIds": [
          "cmt_22222222-2222-4222-8222-222222222222",
          "cmt_99999999-9999-4999-8999-999999999999"
        ]
      }
    },
    {
      "id": "N01-06-duplicate-before-multiple-open",
      "processedResults": ["acceptedMatch"],
      "openComments": ["draft", "pending"],
      "expected": {
        "decision": "duplicate",
        "responseResult": "duplicate",
        "originalResult": "accepted"
      }
    },
    {
      "id": "N01-07-duplicate-existing-comment",
      "processedResults": ["existingMatch"],
      "openComments": [],
      "expected": {
        "decision": "duplicate",
        "responseResult": "duplicate",
        "originalResult": "existing_comment"
      }
    },
    {
      "id": "N01-08-invalid-request-before-multiple-open",
      "processedResults": ["different"],
      "openComments": ["draft", "pending"],
      "expected": {
        "decision": "invalid_request",
        "responseResult": "invalid_request"
      }
    },
    {
      "id": "N01-09-teacher-mismatch-no-disclosure",
      "processedResults": [],
      "openComments": ["otherTeacher"],
      "expected": {
        "decision": "temporary_error",
        "responseResult": "temporary_error",
        "responseHasData": false
      }
    },
    {
      "id": "N01-10-multiple-request-results-sorted",
      "processedResults": ["sortZ", "sortA"],
      "openComments": ["draft"],
      "expected": {
        "decision": "integrity_stop",
        "reasonCode": "multiple_request_results",
        "detectedRequestFingerprints": ["aaa", "zzz"]
      }
    },
    {
      "id": "N01-11-multiple-matching-request-results",
      "processedResults": ["acceptedMatch", "existingMatch"],
      "openComments": [],
      "expected": {
        "decision": "integrity_stop",
        "reasonCode": "multiple_request_results"
      }
    },
    {
      "id": "N01-12-approved-does-not-block",
      "processedResults": [],
      "openComments": ["approved"],
      "expected": {
        "decision": "create_draft"
      }
    },
    {
      "id": "N01-13-existing-response-allowlist",
      "processedResults": [],
      "openComments": ["draft"],
      "expected": {
        "decision": "persist_existing_comment",
        "responseDataKeys": ["commentId", "status", "versionNo"],
        "requestResultKeys": [
          "comment_id",
          "operation",
          "processed_at",
          "request_fingerprint",
          "request_id",
          "result",
          "schema_version",
          "status",
          "version_no"
        ]
      }
    },
    {
      "id": "N01-14-duplicate-response-allowlist",
      "processedResults": ["acceptedMatch"],
      "openComments": [],
      "expected": {
        "decision": "duplicate",
        "responseDataKeys": [
          "commentId",
          "originalResult",
          "status",
          "versionNo"
        ]
      }
    }
